PG_HOST: localhost
PG_PORT: 5432
PG_USER: postgres
PG_PASSWORD: postgres
PG_DBNAME: defaultdb
PG_SSLMODE: disable

# Optional: trigger a stats-web build+deploy after rankings update
# DEPLOY_SCRIPT defaults to /scripts/deploy-web.sh inside the container
DEPLOY_SCRIPT=
CF_PAGES_PROJECT=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Webhook URL fired after 3 consecutive scheduled-job failures
# (Discord/Slack-style receivers both work). Leave empty to disable.
ALERT_WEBHOOK=

# Email alerts after 3 consecutive scheduled-job failures.
# Any STARTTLS (587) or implicit-TLS (465) SMTP relay works
# (Gmail app password, Brevo, Resend, your own provider, ...).
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
